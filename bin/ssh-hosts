#!/usr/bin/env bash
set -euo pipefail

config_item="${SSH_HOSTS_CONFIG_ITEM:-ssh/hosts}"
config_field="${SSH_HOSTS_CONFIG_FIELD:-config}"
local_config="${SSH_HOSTS_LOCAL_CONFIG:-$HOME/.ssh/config.local}"
key_dir="${SSH_HOSTS_KEY_DIR:-$HOME/.ssh/rbw}"

require() {
  command -v "$1" >/dev/null 2>&1 || { printf 'Missing command: %s\n' "$1" >&2; exit 1; }
}

agent_socket() {
  if [[ -n "${RBW_AGENT_SOCKET:-}" ]]; then
    printf '%s\n' "$RBW_AGENT_SOCKET"
  elif [[ "$(uname -s)" == Darwin ]]; then
    printf '%srbw-runtime/rbw/ssh-agent-socket\n' "$(getconf DARWIN_USER_TEMP_DIR)"
  else
    printf '%s/rbw/ssh-agent-socket\n' "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  fi
}

template() {
  cat <<'JSON'
{
  "hosts": [
    {"alias":"server","hostname":"server.example.com","user":"user","key":"server","port":22}
  ],
  "keys": [
    {"name":"server","item":"ssh/keys/server","field":"public key"}
  ]
}
JSON
}

fetch_config() {
  require rbw
  rbw get "$config_item" --field "$config_field"
}

validate_config() {
  jq -e '
    type == "object" and
    (.hosts | type == "array" and length > 0) and
    (.keys | type == "array") and
    ([.hosts[].alias] | length == (unique | length)) and
    ([.keys[].name] | length == (unique | length)) and
    all(.hosts[];
      (.alias | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]*$")) and
      (.hostname | type == "string" and test("^[^\\n\\r[:space:]]+$")) and
      (.user | type == "string" and test("^[A-Za-z0-9._-]+$")) and
      (.key | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]*$")) and
      ((.port // 22) | type == "number" and . >= 1 and . <= 65535) and
      ((.extra // {}) | type == "object") and
      all((.extra // {}) | to_entries[];
        (.key | test("^[A-Za-z][A-Za-z0-9]+$")) and
        (.value | type == "string" and test("^[^\\n\\r]*$")))) and
    all(.keys[];
      (.name | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]*$")) and
      (.item | type == "string" and test("^[^\\n\\r]+$")) and
      (.field | type == "string" and test("^[^\\n\\r]+$"))) and
    all(.hosts[].key as $key; any(.keys[].name; . == $key))
  ' >/dev/null
}

sync_hosts() {
  require jq
  require ssh
  require ssh-keygen

  local config socket config_tmp staging name item field target
  config="$(fetch_config)"
  validate_config <<<"$config" || { printf 'Invalid SSH hosts JSON.\n' >&2; exit 1; }
  socket="$(agent_socket)"

  install -d -m 700 "$HOME/.ssh" "$key_dir"
  staging="$(mktemp -d "$HOME/.ssh/.rbw-keys.XXXXXX")"
  config_tmp="$(mktemp "$HOME/.ssh/.config.local.XXXXXX")"
  trap 'rm -rf "$staging" "$config_tmp"' RETURN

  while IFS=$'\t' read -r name item field; do
    target="$staging/$name.pub"
    rbw get "$item" --field "$field" >"$target"
    ssh-keygen -l -f "$target" >/dev/null
    chmod 600 "$target"
  done < <(jq -r '.keys[] | [.name, .item, .field] | @tsv' <<<"$config")

  {
    printf '# Generated by ssh-hosts; edit Bitwarden item %s, then resync.\n\n' "$config_item"
    jq -r --arg socket "$socket" '
      .hosts[] |
      "Host \(.alias)\n" +
      "    HostName \(.hostname)\n" +
      "    User \(.user)\n" +
      "    Port \(.port // 22)\n" +
      "    IdentityAgent \($socket)\n" +
      "    IdentityFile ~/.ssh/rbw/\(.key).pub\n" +
      "    IdentitiesOnly yes\n" +
      ((.extra // {}) | to_entries | map("    \(.key) \(.value)\n") | join("")) + "\n"
    ' <<<"$config"
  } >"$config_tmp"
  chmod 600 "$config_tmp"

  # Parse every generated stanza before changing the live configuration.
  while IFS= read -r alias; do
    ssh -F "$config_tmp" -G "$alias" >/dev/null
  done < <(jq -r '.hosts[].alias' <<<"$config")

  find "$key_dir" -maxdepth 1 -type f -name '*.pub' -delete
  find "$staging" -maxdepth 1 -type f -name '*.pub' -exec mv {} "$key_dir/" \;
  mv "$config_tmp" "$local_config"
  rmdir "$staging"
  trap - RETURN
  printf 'Updated %s and %s.\n' "$local_config" "$key_dir"
}

list_hosts() {
  local config
  config="$(fetch_config)"
  validate_config <<<"$config"
  jq -r '.hosts[] | [.alias, (.user + "@" + .hostname), .key] | @tsv' <<<"$config"
}

test_host() {
  [[ -n "${1:-}" ]] || { printf 'Usage: ssh-hosts test HOST\n' >&2; exit 2; }
  ssh -o BatchMode=yes -T "$1"
}

usage() {
  cat <<EOF
Usage: ssh-hosts COMMAND

  sync       Generate SSH config and public-key selectors from Bitwarden
  list       List configured hosts
  test HOST  Test non-interactive authentication
  template   Print example Bitwarden JSON

Bitwarden source defaults to item '$config_item', field '$config_field'.
Override it with SSH_HOSTS_CONFIG_ITEM and SSH_HOSTS_CONFIG_FIELD.
EOF
}

case "${1:-}" in
  sync) sync_hosts ;;
  list) list_hosts ;;
  test) shift; test_host "${1:-}" ;;
  template) template ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; exit 2 ;;
esac
